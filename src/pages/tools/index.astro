---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getTools } from "@/lib/tools";
import config from "@/config";

const tools = getTools();
---

<Layout title={`Tools | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle="Tools"
    pageDesc="Small tools that maybe one other person will find useful"
  >
    {
      tools.length === 0 ? (
        <p class="text-muted-foreground">
          There are no tools to show at the moment. Check back later!
        </p>
      ) : (
        <ul>
          {tools.map(tool => (
            <li class="my-8 first:mt-0 last:mb-0">
              {/* Links take the highlighter, never the accent colour — the
                  same treatment every other list on the site uses. */}
              <a
                href={tool.href}
                class="mark-hover text-foreground text-xl font-semibold focus-visible:no-underline"
              >
                {tool.title}
              </a>
              {tool.description && <p class="mt-1.5">{tool.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
