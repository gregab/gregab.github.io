---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ResourceLink from "@/components/ResourceLink.astro";
import ResourceMeta from "@/components/ResourceMeta.astro";
import { getResourceTree } from "@/lib/resources";
import config from "@/config";

const categories = await getResourceTree();
const isEmpty = categories.length === 0;
---

<Layout title={`Resources | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Resources"
    pageDesc="A growing list of things I have found interesting and helpful"
  >
    {
      isEmpty ? (
        <p class="text-muted-foreground">
          No resources listed yet. Check back later!
        </p>
      ) : (
        categories.map(category => (
          <section class="mb-16 last:mb-4">
            <h2
              id={category.id}
              class="border-border mb-9 border-b pb-2 text-2xl font-semibold sm:text-3xl"
            >
              {category.name}
            </h2>

            {category.sections.map(section => (
              <div class="mb-11 last:mb-0">
                {/* A kicker rather than a heading: it labels what follows
                    without competing with the names underneath it. */}
                <h3 class="font-ui text-muted-foreground mb-7 text-xs font-semibold tracking-[0.18em] uppercase">
                  {section.name}
                </h3>

                {section.groups.map(group => (
                  <div class="mb-9 last:mb-0">
                    {group.name && (
                      <h4 class="text-xl font-semibold">{group.name}</h4>
                    )}

                    {group.profiles.map(profile => (
                      <div class="mt-1.5">
                        <a
                          href={profile.data.url}
                          target="_blank"
                          rel="noreferrer"
                          class="marked text-foreground font-medium focus-visible:no-underline"
                        >
                          {/* The Substack is titled "Jonathan Shedler" too,
                              so fall back to the source rather than echo the
                              heading directly above it. */}
                          {profile.data.title === group.name
                            ? (profile.data.source ?? profile.data.title)
                            : profile.data.title}
                        </a>
                        <ResourceMeta
                          resource={profile.data}
                          skipSource={profile.data.title === group.name}
                          class="inline"
                          separator
                        />
                        {profile.data.note && (
                          <p class="mt-2">{profile.data.note}</p>
                        )}
                      </div>
                    ))}

                    {/* The rule means "these belong to the name above", so an
                        ungrouped list sits flush instead. */}
                    {group.items.length > 0 && (
                      <ul
                        class:list={[
                          group.name && "border-border mt-5 border-s ps-5",
                        ]}
                      >
                        {group.items.map(entry => (
                          <ResourceLink
                            resource={entry.data}
                            implied={section.implied}
                          />
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </section>
        ))
      )
    }
  </Main>

  <Footer />
</Layout>
