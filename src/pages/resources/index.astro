---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const resources = await getCollection("resources");

const groups = new Map<string, typeof resources>();
for (const resource of resources) {
  const category = resource.data.category;
  if (!groups.has(category)) groups.set(category, []);
  groups.get(category)!.push(resource);
}

const sortedCategories = [...groups.keys()].sort((a, b) => a.localeCompare(b));
---

<Layout title={`Resources | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageDesc="Curated outbound links, grouped by category." pageTitle="Resources">
    {
      resources.length === 0 ? (
        <p class="text-muted-foreground">
          No resources listed yet. Check back later!
        </p>
      ) : (
        sortedCategories.map(category => (
          <section class="mb-8">
            <h2 class="mb-3 text-xl font-semibold">{category}</h2>
            <ul>
              {groups
                .get(category)!
                .sort((a, b) => a.data.title.localeCompare(b.data.title))
                .map(resource => (
                  <li class="my-4">
                    <a
                      href={resource.data.url}
                      target="_blank"
                      rel="noreferrer"
                      class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
                    >
                      {resource.data.title}
                    </a>
                    <p>{resource.data.note}</p>
                  </li>
                ))}
            </ul>
          </section>
        ))
      )
    }
  </Main>

  <Footer />
</Layout>
