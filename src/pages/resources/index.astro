---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ResourceLink from "@/components/ResourceLink.astro";
import { getResourceTree } from "@/lib/resources";
import config from "@/config";

const categories = await getResourceTree();
const isEmpty = categories.length === 0;

/* With only one category, its name would just repeat the page title, so the
   heading only earns its place once there are several to tell apart — and
   without it the names beneath move up a level rather than skipping one. */
const showCategories = categories.length > 1;
const PersonHeading = showCategories ? "h3" : "h2";
---

<Layout title={`Resources | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Resources"
    pageDesc="A growing list of things I have found interesting and helpful"
  >
    {
      isEmpty ? (
        <p class="text-muted-foreground">
          No resources listed yet. Check back later!
        </p>
      ) : (
        categories.map(category => (
          <section class="mb-16 last:mb-4">
            {showCategories && (
              <h2
                id={category.id}
                class="border-border mb-9 border-b pb-2 text-2xl font-semibold sm:text-3xl"
              >
                {category.name}
              </h2>
            )}

            {category.groups.map(group => (
              <div class="mb-14 last:mb-0">
                {group.name && (
                  <PersonHeading class="text-2xl font-semibold">
                    {/* The name is the way in to everything else they have
                        made, so it points at their own site when we know it. */}
                    {group.url ? (
                      <a
                        href={group.url}
                        target="_blank"
                        rel="noreferrer"
                        class="marked text-foreground focus-visible:no-underline"
                      >
                        {group.name}
                      </a>
                    ) : (
                      group.name
                    )}
                  </PersonHeading>
                )}

                {/* The rule means "these belong to the name above", so an
                    ungrouped list sits flush instead. */}
                <ul
                  class:list={[
                    group.name && "border-border mt-5 border-s ps-5",
                  ]}
                >
                  {group.entries.map(entry => (
                    <ResourceLink resource={entry.data} groupName={group.name} />
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      )
    }
  </Main>

  <Footer />
</Layout>
