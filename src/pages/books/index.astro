---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

dayjs.extend(localizedFormat);

const books = (await getCollection("books")).sort(
  (a, b) => b.data.dateRead.valueOf() - a.data.dateRead.valueOf()
);

const rendered = await Promise.all(
  books.map(async (book) => {
    const { Content } = await render(book);
    return { book, Content };
  })
);
---

<BaseLayout title="Books" sideBarActiveItemID="books">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Books</div>
  </div>

  {
    rendered.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Sorry!</p>
        <p>No book notes yet. Check back later!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-6">
        {rendered.map(({ book, Content }) => (
          <li class="card bg-base-200">
            <div class="card-body flex-col md:flex-row gap-4">
              {book.data.coverImage && (
                <img
                  src={book.data.coverImage}
                  alt={`Cover of ${book.data.title}`}
                  width="120"
                  height="180"
                  class="rounded shadow-sm max-w-[120px] self-start"
                />
              )}
              <div class="grow">
                <h2 class="card-title">{book.data.title}</h2>
                <p class="opacity-75 mb-1">{book.data.author}</p>
                <div class="flex items-center gap-3 mb-3">
                  <span class="badge badge-secondary" aria-label={`Rating: ${book.data.rating} out of 5`}>
                    {"★".repeat(book.data.rating)}
                    {"☆".repeat(5 - book.data.rating)}
                  </span>
                  <time class="opacity-60 text-sm">Read {dayjs(book.data.dateRead).format("ll")}</time>
                </div>
                <div class="prose max-w-none">
                  <Content />
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
