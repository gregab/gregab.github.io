---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { SUBSTACK_URL, SUBSTACK_POSTS } from "../../data/substack";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

dayjs.extend(localizedFormat);

const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Writing" sideBarActiveItemID="writing">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Writing</div>
  </div>

  <section aria-labelledby="essays-heading">
    <h2 id="essays-heading" class="text-2xl font-bold mb-3">Essays</h2>

    {
      essays.length === 0 ? (
        <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
          <p class="font-bold">Sorry!</p>
          <p>There are no essays to show at the moment. Check back later!</p>
        </div>
      ) : (
        <ul>
          {essays.map((post) => (
            <>
              <HorizontalCard
                title={post.data.title}
                img={post.data.heroImage}
                desc={post.data.description}
                url={"/writing/" + createSlug(post.data.title, post.id)}
                target="_self"
                tags={post.data.tags}
              />
              <div class="divider my-0" />
            </>
          ))}
        </ul>
      )
    }
  </section>

  <div class="divider my-10"></div>

  <section aria-labelledby="newsletter-heading" class="rounded-lg bg-base-200 p-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <h2 id="newsletter-heading" class="text-2xl font-bold">Newsletter</h2>
      <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noreferrer">
        Subscribe on Substack
      </a>
    </div>
    <p class="opacity-75 mb-4">Recent posts from the Substack newsletter — not hosted on this site.</p>
    <ul class="flex flex-col gap-2">
      {
        SUBSTACK_POSTS.map((post) => (
          <li class="card bg-base-100 shadow-sm">
            <a href={post.url} target="_blank" rel="noreferrer" class="card-body py-3 px-4 flex-row items-center justify-between gap-3">
              <span class="font-semibold">{post.title}</span>
              <time class="opacity-60 whitespace-nowrap">{dayjs(post.date).format("ll")}</time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
