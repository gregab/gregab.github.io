---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { type EssaysSchema } from "../../content.config";
import PostLayout from "../../layouts/PostLayout.astro";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const postEntries = await getCollection("essays", ({ data }) => !data.draft);
  return postEntries.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"essays">;
}

const { entry } = Astro.props;
const post: EssaysSchema = entry.data;
const { Content } = await render(entry);
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  heroImage={post.heroImage}
  updatedDate={post.updatedDate}
  tags={post.tags}
>
  <Content />
</PostLayout>
