---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CuriosityTimeline from "@/components/CuriosityTimeline.astro";
import { CURIOSITY_TIMELINE } from "@/data/curiosity";
import config from "@/config";
---

<Layout title={`Curiosity Timeline | ${config.site.title}`}>
  <Header />

  <Main pageTitle="Curiosity Timeline">
    <CuriosityTimeline entries={CURIOSITY_TIMELINE} />
  </Main>

  <Footer />
</Layout>
