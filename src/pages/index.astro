---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { getTools } from "../lib/tools";

const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentEssays = essays.slice(0, 3);

const tools = getTools();
const recentTools = tools.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Greg Bigelow</div>
    <div class="py-4">
      <p class="text-lg mb-4">
        <!-- PLACEHOLDER BIO — replace with a real one. -->
        This is a placeholder bio. Greg writes about [topics to fill in], builds small
        single-page tools when a problem is annoying enough to be worth automating, and
        occasionally reads a book worth reviewing.
      </p>
      <p class="text-lg mb-4">
        This site collects that work in one place: essays and newsletter posts under
        <a class="link" href="/writing">Writing</a>, self-contained utilities under
        <a class="link" href="/tools">Tools</a>, curated links under
        <a class="link" href="/resources">Resources</a>, and book notes under
        <a class="link" href="/books">Books</a>.
      </p>
      <p class="text-lg">
        Everything on this page — this bio included — is a stand-in until it gets replaced
        with the real thing.
      </p>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Latest writing</div>
  </div>

  {
    recentEssays.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p>Nothing published yet — check back soon.</p>
      </div>
    ) : (
      recentEssays.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/writing/" + createSlug(post.data.title, post.id)}
            target="_self"
          />
          <div class="divider my-0" />
        </>
      ))
    )
  }
  <div class="text-right mt-2">
    <a class="link" href="/writing">See all writing &rarr;</a>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest tools</div>
  </div>

  {
    recentTools.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p>No tools published yet.</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-2">
        {recentTools.map((tool) => (
          <li class="card bg-base-200">
            <a href={tool.href} class="card-body py-3 px-4">
              <span class="font-semibold">{tool.title}</span>
              {tool.description && <span class="opacity-75 text-sm">{tool.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <div class="text-right mt-2">
    <a class="link" href="/tools">See all tools &rarr;</a>
  </div>
</BaseLayout>
