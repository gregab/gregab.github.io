---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getTools } from "@/lib/tools";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const tools = getTools();

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">Hello</h1>

      <!--
        Greg's bio, from the Obsidian staging folder (Website/bio.md).
        His wording and his paragraph breaks — keep them in sync with that file.
      -->
      <p class="mt-4">
        I enjoy exploring: the world, myself, and what it means to live a full
        human life. I hope my time on Earth is of some benefit to others and the
        civilization we are building together. Some stages of life: I went deep
        into speech and debate at Gig Harbor High School, studied computer
        science and philosophy at the University of Washington, spent eight
        years as a software engineer at Facebook where I helped create and grow
        Facebook Marketplace, spent over two years in Buddhist silent meditation
        retreat, saw some of the world, lived in a Zen Monastery, and am
        currently in a Master's in Clinical Mental Health Counseling training to
        be a psychotherapist. And, of course, working to make this website
        useful.
      </p>
      <p class="mt-4">
        I currently live in beautiful Portland, Oregon, though I have a deep
        fondness for exploring the deserts of the American Southwest. I hope you
        find something of value here and I appreciate your visit to my humble
        internet home.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      tools.length > 0 && (
        <section id="tools" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentTools}
          </h2>
          <ul>
            {tools.slice(0, 3).map(tool => (
              <li class="my-6">
                <a
                  href={tool.href}
                  class="marked text-foreground inline-block text-xl font-semibold focus-visible:no-underline"
                >
                  {tool.title}
                </a>
                {tool.description && <p class="mt-1">{tool.description}</p>}
              </li>
            ))}
          </ul>
          {tools.length > 3 && (
            <div class="mt-4">
              <LinkButton
                class="marked"
                href={getRelativeLocaleUrl(locale, "tools")}
              >
                {t.home.allTools}
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </LinkButton>
            </div>
          )}
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
