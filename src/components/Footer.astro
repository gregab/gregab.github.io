---
/*
  No copyright line: copyright is automatic, and the notice was the only thing
  making this a "footer" rather than a way to get in touch. The strings are
  still in `src/i18n/lang/en.ts` under `footer` if it ever comes back.
*/
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border flex items-center justify-center border-t py-5">
    <Socials />
  </div>
</footer>
