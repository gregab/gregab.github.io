---
/*
  The curiosity timeline as a corridor: a first-person gallery you walk down,
  each book in a gilt frame with a brass plaque, alternating left and right
  the way the 2D timeline zigzags. The scene itself is built in
  src/scripts/corridor/ from the entries passed here; this file is the shell
  — canvas, touch stick, the aimed-book label, a fullscreen toggle, the help
  line — plus two fallbacks:

  - no WebGL (iOS Lockdown Mode, some corporate browsers): the corridor root
    is swapped for the 2D CuriosityTimeline kept in a <template>;
  - no JavaScript: the same timeline inside <noscript>.

  The visually-hidden list inside the root is what screen readers get; the
  canvas is decorative to them.
*/
import type { CuriosityEntry } from "@/data/curiosity";
import CuriosityTimeline from "./CuriosityTimeline.astro";

type Props = {
  entries: CuriosityEntry[];
};

const { entries } = Astro.props;

// Only what the scene needs, and no `<` that could close the script tag.
const payload = JSON.stringify(
  entries.map(e => ({
    title: e.title,
    author: e.author,
    url: e.url,
    series: e.series,
    cover: e.cover,
    lookup: e.lookup,
  }))
).replace(/</g, "\\u003c");
---

<section class="corridor" data-corridor aria-label="Curiosity corridor">
  <canvas
    class="corridor-canvas"
    tabindex="0"
    aria-label="A walkable corridor of the books listed below. Arrow keys walk and turn; Enter opens the book you are facing."
  ></canvas>

  <div class="corridor-stick" data-stick aria-hidden="true">
    <div class="corridor-knob" data-knob></div>
  </div>
  <div class="corridor-stick-hint" aria-hidden="true"></div>

  <a
    class="corridor-label font-ui"
    data-label
    hidden
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="corridor-label-title" data-label-title></span>
    <span class="corridor-label-meta" data-label-meta></span>
    <span class="corridor-label-cta">Goodreads ↗</span>
  </a>

  <button
    class="corridor-fs font-ui"
    type="button"
    data-fullscreen
    aria-pressed="false"
  >
    <span class="corridor-fs-enter">Fullscreen</span>
    <span class="corridor-fs-exit">Exit fullscreen</span>
  </button>

  <ol class="sr-only">
    {
      entries.map(entry => (
        <li>
          <a href={entry.url} target="_blank" rel="noopener noreferrer">
            {entry.title}
          </a>
          {entry.author && <span> — {entry.author}</span>}
          {entry.series && <span> (series)</span>}
        </li>
      ))
    }
  </ol>

  <script is:inline type="application/json" data-corridor-entries set:html={payload} />
</section>

<p class="corridor-help font-ui text-muted-foreground" data-corridor-help>
  <span class="corridor-help-keys">
    Walk with <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or the arrow
    keys · drag to look around · click a frame to open it on Goodreads
  </span>
  <span class="corridor-help-touch">
    Drag in the lower left to walk · drag anywhere else to look around ·
    tap a frame to open it on Goodreads
  </span>
</p>

<template data-corridor-fallback>
  <CuriosityTimeline entries={entries} />
</template>

<noscript>
  <style>
    .corridor,
    .corridor-help {
      display: none;
    }
  </style>
  <CuriosityTimeline entries={entries} />
</noscript>

<style>
  /*
    The corridor breaks out of the 40rem measure — a hallway wants width —
    but stays capped and inset on large screens so it reads as a window in
    the page rather than a takeover. Phones get the full width.
  */
  .corridor {
    --w: min(100vw - 3rem, 68rem);
    position: relative;
    width: var(--w);
    height: min(78svh, 46rem);
    min-height: 20rem;
    margin-inline: calc(50% - var(--w) / 2);
    background: var(--muted);
    overflow: hidden;
    border: 1px solid var(--border);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 40rem) {
    .corridor {
      --w: 100vw;
      border-inline: 0;
      height: min(74svh, 46rem);
    }
  }
  .corridor.is-fullscreen {
    --w: 100%;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
  }

  .corridor-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    outline-offset: -3px;
  }
  .corridor.is-ready .corridor-canvas {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .corridor-canvas {
      transition: opacity 700ms ease;
    }
  }

  /* A vignette, so the edges of the window fall away into the frame. */
  .corridor::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 55%,
      rgb(20 12 6 / 0.35) 100%
    );
  }

  /* ---- touch stick ---------------------------------------------------- */
  .corridor-stick {
    position: absolute;
    left: 0;
    top: 0;
    width: 104px;
    height: 104px;
    margin: -52px 0 0 -52px;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.08);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25) inset;
    pointer-events: none;
    display: none;
    z-index: 2;
  }
  .corridor.is-stick .corridor-stick {
    display: block;
  }
  .corridor-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
  }
  /* At rest on a touch screen, a faint ring shows where the stick lives. */
  .corridor-stick-hint {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 1.5px dashed rgb(255 255 255 / 0.4);
    pointer-events: none;
    display: none;
    z-index: 1;
  }
  .corridor-stick-hint::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.35);
  }
  .corridor[data-touch]:not(.is-stick) .corridor-stick-hint {
    display: block;
  }

  /* ---- the aimed book -------------------------------------------------- */
  /* Top-centre, clear of the label beside each frame and of the stick and
     look-drag on touch screens. It repeats what the plaque says, so it is
     set small: a caption, not a headline. */
  .corridor-label {
    position: absolute;
    left: 50%;
    top: 0.85rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    /* Leaves the fullscreen button's corner clear at narrow desktop widths. */
    max-width: min(100% - 10rem, 26rem);
    padding: 0.5rem 1rem 0.55rem;
    border-radius: 0.35rem;
    background: rgb(22 15 10 / 0.62);
    color: #f5eee4;
    text-decoration: none;
    text-align: center;
    line-height: 1.3;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  .corridor-label:hover .corridor-label-cta {
    text-decoration: underline;
  }
  /* On a touch screen the caption becomes a full-width band, like a wall
     label, and the fullscreen button moves out of its way. */
  .corridor[data-touch] .corridor-label {
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    max-width: none;
    border-radius: 0;
    padding: 0.5rem 1rem 0.6rem;
  }
  .corridor[data-touch] .corridor-label-title {
    font-size: 1.05rem;
  }
  .corridor[data-touch] .corridor-label-meta {
    font-size: 0.8rem;
  }
  .corridor[data-touch] .corridor-fs {
    top: auto;
    bottom: 0.75rem;
    right: 0.75rem;
  }
  .corridor-label-title {
    font-family: var(--font-newsreader);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .corridor-label-meta {
    margin-top: 0.1rem;
    font-size: 0.8rem;
    color: #d9cdbd;
  }
  .corridor-label-meta:empty {
    display: none;
  }
  .corridor-label-cta {
    margin-top: 0.15rem;
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(var(--mark));
  }

  /* ---- fullscreen ------------------------------------------------------ */
  .corridor-fs {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 0.3rem;
    background: rgb(22 15 10 / 0.35);
    color: #f5eee4;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .corridor-fs:hover {
    background: rgb(22 15 10 / 0.55);
  }
  .corridor-fs-exit {
    display: none;
  }
  .corridor.is-fullscreen .corridor-fs-enter {
    display: none;
  }
  .corridor.is-fullscreen .corridor-fs-exit {
    display: inline;
  }

  /* ---- help line ------------------------------------------------------- */
  .corridor-help {
    margin: 0.8rem auto 0;
    max-width: 40rem;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .corridor-help kbd {
    display: inline-block;
    min-width: 1.3em;
    margin-inline: 0.05em;
    padding: 0 0.3em;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 0.2em;
    font-family: var(--font-plex-mono);
    font-size: 0.85em;
    line-height: 1.5;
    text-align: center;
  }
  .corridor-help-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .corridor-help-keys {
      display: none;
    }
    .corridor-help-touch {
      display: inline;
    }
  }
</style>

<script>
  /*
    three.js is a large dependency, so it loads as its own chunk after the
    page is up rather than in the critical path.
  */
  async function mount() {
    const root = document.querySelector<HTMLElement>("[data-corridor]");
    if (!root) return;
    const { mountCorridor } = await import("@/scripts/corridor/corridor");
    // The visitor may have navigated away while the chunk was loading.
    if (document.contains(root)) mountCorridor(root);
  }
  document.addEventListener("astro:page-load", () => void mount());
  document.addEventListener("astro:before-swap", () => {
    void import("@/scripts/corridor/corridor").then(m => m.unmountCorridor());
  });
</script>
