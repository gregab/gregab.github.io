---
/*
  One thing worth reading or listening to. Every entry carries its format
  label: the list under a person mixes podcasts, articles and newsletters,
  and with no "Podcasts" heading overhead the label is the only thing that
  says what a link will hand you.
*/
import ResourceMeta from "./ResourceMeta.astro";
import type { Resource } from "@/lib/resources";

type Props = {
  resource: Resource;
  /** The heading this sits under, so the link text can avoid echoing it. */
  groupName?: string;
};

const { resource, groupName } = Astro.props;

// Under a heading that already says the person's name, repeating it reads as
// a stutter — Shedler's Substack is titled "Jonathan Shedler", and Sachter's
// article is bylined to him. The source names the Substack just as well, and
// the byline is simply dropped.
const echoesHeading = Boolean(groupName) && resource.title === groupName;
const label = echoesHeading
  ? (resource.source ?? resource.title)
  : resource.title;
const bylineEchoesHeading = Boolean(groupName) && resource.byline === groupName;

const FORMAT_LABEL: Record<Resource["format"], string> = {
  podcast: "Podcast",
  article: "Article",
  newsletter: "Newsletter",
  group: "Group",
};
---

<li class="my-7 first:mt-0 last:mb-0">
  <p
    class="font-mono text-muted-foreground mb-1.5 text-[0.7rem] tracking-[0.14em] uppercase"
  >
    {FORMAT_LABEL[resource.format]}
  </p>

  <a
    href={resource.url}
    target="_blank"
    rel="noreferrer"
    class="marked text-foreground text-lg font-semibold focus-visible:no-underline"
  >
    {label}
  </a>

  <ResourceMeta
    resource={resource}
    skipSource={echoesHeading}
    skipByline={bylineEchoesHeading}
    class="mt-1.5"
  />

  {resource.note && <p class="mt-2">{resource.note}</p>}
</li>
