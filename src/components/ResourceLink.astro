---
/*
  One thing worth reading or listening to. The format label only renders when
  an entry breaks its section's pattern — a label that repeats the heading
  above it is noise, so a podcast under "Podcasts" goes unlabelled and
  anything else announces itself.
*/
import ResourceMeta from "./ResourceMeta.astro";
import type { Resource } from "@/lib/resources";

type Props = {
  resource: Resource;
  /** The format the surrounding section already implies. */
  implied?: string;
  /** The heading this sits under, so the link text can avoid echoing it. */
  groupName?: string;
};

const { resource, implied, groupName } = Astro.props;

// Shedler's Substack is titled "Jonathan Shedler", which under a heading that
// already says Jonathan Shedler reads as a stutter. Its source names it just
// as well, and then the meta line below needn't repeat that either.
const echoesHeading = Boolean(groupName) && resource.title === groupName;
const label = echoesHeading ? (resource.source ?? resource.title) : resource.title;

const FORMAT_LABEL: Record<Resource["format"], string> = {
  podcast: "Podcast",
  article: "Article",
  newsletter: "Newsletter",
  group: "Group",
};
---

<li class="my-7 first:mt-0 last:mb-0">
  {
    resource.format !== implied && (
      <p class="font-mono text-muted-foreground mb-1.5 text-[0.7rem] tracking-[0.14em] uppercase">
        {FORMAT_LABEL[resource.format]}
      </p>
    )
  }

  <a
    href={resource.url}
    target="_blank"
    rel="noreferrer"
    class="marked text-foreground text-lg font-semibold focus-visible:no-underline"
  >
    {label}
  </a>

  <ResourceMeta resource={resource} skipSource={echoesHeading} class="mt-1.5" />

  {resource.note && <p class="mt-2">{resource.note}</p>}
</li>
